# ----------------------------------------------------------------------------
# Sai Nitish Reddy Kapa - Portfolio environment variables
# Copy this file to ".env.local" and fill in the values you need.
# Every value below is OPTIONAL. The site runs fully without any of them.
# ----------------------------------------------------------------------------

# Public site URL, used for SEO canonical links, sitemap and Open Graph tags.
# Example: https://sainitish.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Contact form delivery (optional)
# ----------------------------------------------------------------------------
# The contact form works out of the box and logs submissions on the server.
# To actually deliver messages by email, add a Resend API key.
# Get one free at https://resend.com
RESEND_API_KEY=

# The verified "from" address Resend will send on behalf of.
# Example: portfolio@yourdomain.com
CONTACT_FROM_EMAIL=

# Where contact messages should be delivered.
CONTACT_TO_EMAIL=kapasainitishreddy@gmail.com

# ----------------------------------------------------------------------------
# Analytics (disabled by default)
# ----------------------------------------------------------------------------
# Set to "true" only if you explicitly want to load Vercel Analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
