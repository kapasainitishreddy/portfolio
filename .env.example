# ----------------------------------------------------------------------------
# Sai Nitish Reddy Kapa - Portfolio environment variables
# Copy this file to ".env.local" for local development.
# Production release requirements are documented in DEPLOYMENT.md.
# ----------------------------------------------------------------------------

# REQUIRED IN PRODUCTION: exact public HTTPS origin used by canonical metadata,
# sitemap, Open Graph, and JSON-LD. Keep localhost only for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Contact form delivery
# ----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION if the contact form is enabled. The API intentionally
# returns 503 when delivery is unconfigured; it never logs and pretends to have
# delivered a visitor message.
RESEND_API_KEY=

# Verified sender allowed by the Resend account.
CONTACT_FROM_EMAIL=

# Destination mailbox.
CONTACT_TO_EMAIL=kapasainitishreddy@gmail.com

# ----------------------------------------------------------------------------
# Analytics (disabled by default)
# ----------------------------------------------------------------------------
# Enable only after intentionally updating the privacy disclosure and release
# verification for the selected analytics provider.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
